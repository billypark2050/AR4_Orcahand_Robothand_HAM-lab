<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar4_orca_description</name>
  <version>0.1.0</version>
  <description>Combined robot_description: Annin AR4 arm + ORCA Hand v2 on the flange (mount pose parameterised).</description>
  <maintainer email="billypark2050@gmail.com">Billy Park</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>annin_ar4_description</exec_depend>
  <exec_depend>annin_ar4_driver</exec_depend>
  <exec_depend>orcahand_ros_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
