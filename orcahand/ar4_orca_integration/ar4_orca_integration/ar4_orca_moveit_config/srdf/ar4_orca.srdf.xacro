<?xml version="1.0"?>
<!--
  AR4 mk5 + ORCA Hand v2 semantic description for MoveIt (pairs with ar4_orca_description/urdf/ar4_orca.urdf.xacro).
  Groups
    ar_manipulator : joint_1..6, chain base_link -> <hand_prefix>tower  (the IK tip is the hand base where the
                     ORCA wrist joint sits, so a goal pose for the hand is solved through the connector + forearm)
    orca_hand      : all 17 hand joints (driven by /orcahand_driver/follow_joint_trajectory)
  disable_collisions were generated by sampling 10000 random states with the real collision meshes
  (Adjacent / Default / Never, plus "User" = every hand-internal pair: finger contact is allowed).
  Regenerate them if the mount / connector geometry changes.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ar4_orca">
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="hand_prefix" default="hand_"/>
  <xacro:property name="tfp" value="$(arg tf_prefix)"/>
  <xacro:property name="hp" value="$(arg hand_prefix)"/>

  <group name="ar_manipulator">
    <chain base_link="${tfp}base_link" tip_link="${hp}tower"/>
  </group>
  <group name="orca_hand">
    <joint name="${hp}wrist"/>
    <joint name="${hp}thumb_cmc"/>
    <joint name="${hp}thumb_abd"/>
    <joint name="${hp}thumb_mcp"/>
    <joint name="${hp}thumb_dip"/>
    <joint name="${hp}index_abd"/>
    <joint name="${hp}index_mcp"/>
    <joint name="${hp}index_pip"/>
    <joint name="${hp}middle_abd"/>
    <joint name="${hp}middle_mcp"/>
    <joint name="${hp}middle_pip"/>
    <joint name="${hp}ring_abd"/>
    <joint name="${hp}ring_mcp"/>
    <joint name="${hp}ring_pip"/>
    <joint name="${hp}pinky_abd"/>
    <joint name="${hp}pinky_mcp"/>
    <joint name="${hp}pinky_pip"/>
  </group>

  <end_effector name="orca_hand_ee" parent_link="${hp}tower" group="orca_hand" parent_group="ar_manipulator"/>

  <group_state name="home" group="ar_manipulator">
    <joint name="${tfp}joint_1" value="0.0000"/>
    <joint name="${tfp}joint_2" value="0.0000"/>
    <joint name="${tfp}joint_3" value="0.0000"/>
    <joint name="${tfp}joint_4" value="0.0000"/>
    <joint name="${tfp}joint_5" value="0.0000"/>
    <joint name="${tfp}joint_6" value="0.0000"/>
  </group_state>
  <group_state name="upright" group="ar_manipulator">
    <joint name="${tfp}joint_1" value="0.0000"/>
    <joint name="${tfp}joint_2" value="0.0000"/>
    <joint name="${tfp}joint_3" value="-1.5708"/>
    <joint name="${tfp}joint_4" value="0.0000"/>
    <joint name="${tfp}joint_5" value="0.0000"/>
    <joint name="${tfp}joint_6" value="0.0000"/>
  </group_state>
  <group_state name="neutral" group="orca_hand">
    <joint name="${hp}wrist" value="-0.3491"/>
    <joint name="${hp}thumb_cmc" value="0.0000"/>
    <joint name="${hp}thumb_abd" value="0.8727"/>
    <joint name="${hp}thumb_mcp" value="0.5760"/>
    <joint name="${hp}thumb_dip" value="0.3142"/>
    <joint name="${hp}index_abd" value="-0.2443"/>
    <joint name="${hp}index_mcp" value="0.0349"/>
    <joint name="${hp}index_pip" value="0.1047"/>
    <joint name="${hp}middle_abd" value="-0.0698"/>
    <joint name="${hp}middle_mcp" value="0.0349"/>
    <joint name="${hp}middle_pip" value="0.0698"/>
    <joint name="${hp}ring_abd" value="0.1745"/>
    <joint name="${hp}ring_mcp" value="-0.0349"/>
    <joint name="${hp}ring_pip" value="0.1396"/>
    <joint name="${hp}pinky_abd" value="0.3840"/>
    <joint name="${hp}pinky_mcp" value="-0.0698"/>
    <joint name="${hp}pinky_pip" value="-0.0349"/>
  </group_state>
  <group_state name="open" group="orca_hand">
    <joint name="${hp}wrist" value="0.0000"/>
    <joint name="${hp}thumb_cmc" value="0.0000"/>
    <joint name="${hp}thumb_abd" value="0.5236"/>
    <joint name="${hp}thumb_mcp" value="0.0000"/>
    <joint name="${hp}thumb_dip" value="0.0000"/>
    <joint name="${hp}index_abd" value="0.0000"/>
    <joint name="${hp}index_mcp" value="0.0000"/>
    <joint name="${hp}index_pip" value="0.0000"/>
    <joint name="${hp}middle_abd" value="0.0000"/>
    <joint name="${hp}middle_mcp" value="0.0000"/>
    <joint name="${hp}middle_pip" value="0.0000"/>
    <joint name="${hp}ring_abd" value="0.0000"/>
    <joint name="${hp}ring_mcp" value="0.0000"/>
    <joint name="${hp}ring_pip" value="0.0000"/>
    <joint name="${hp}pinky_abd" value="0.0000"/>
    <joint name="${hp}pinky_mcp" value="0.0000"/>
    <joint name="${hp}pinky_pip" value="0.0000"/>
  </group_state>
  <group_state name="fist" group="orca_hand">
    <joint name="${hp}wrist" value="0.0000"/>
    <joint name="${hp}thumb_cmc" value="0.0000"/>
    <joint name="${hp}thumb_abd" value="0.7854"/>
    <joint name="${hp}thumb_mcp" value="0.8727"/>
    <joint name="${hp}thumb_dip" value="1.0472"/>
    <joint name="${hp}index_abd" value="0.0000"/>
    <joint name="${hp}index_mcp" value="1.4835"/>
    <joint name="${hp}index_pip" value="1.5708"/>
    <joint name="${hp}middle_abd" value="0.0000"/>
    <joint name="${hp}middle_mcp" value="1.4835"/>
    <joint name="${hp}middle_pip" value="1.5708"/>
    <joint name="${hp}ring_abd" value="0.0000"/>
    <joint name="${hp}ring_mcp" value="1.4835"/>
    <joint name="${hp}ring_pip" value="1.5708"/>
    <joint name="${hp}pinky_abd" value="0.0000"/>
    <joint name="${hp}pinky_mcp" value="1.4835"/>
    <joint name="${hp}pinky_pip" value="1.5708"/>
  </group_state>

  <!-- Adjacent -->
  <disable_collisions link1="${hp}carpals" link2="${tfp}hand_connector" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}forearm" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}index_ap" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}middle_ap" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}pinky_ap" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}ring_ap" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}thumb_tp" reason="Adjacent"/>
  <disable_collisions link1="${hp}carpals" link2="${hp}tower" reason="Adjacent"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}forearm" reason="Adjacent"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}tower" reason="Adjacent"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${tfp}link_5_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${hp}forearm" link2="${hp}tower" reason="Adjacent"/>
  <disable_collisions link1="${hp}forearm" link2="${tfp}link_5_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${hp}index_ap" link2="${hp}index_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}index_fingertip_assembly" link2="${hp}index_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}middle_ap" link2="${hp}middle_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}middle_fingertip_assembly" link2="${hp}middle_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}pinky_ap" link2="${hp}pinky_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}pinky_fingertip_assembly" link2="${hp}pinky_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}ring_ap" link2="${hp}ring_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}ring_fingertip_assembly" link2="${hp}ring_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}thumb_ap" link2="${hp}thumb_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}thumb_ap" link2="${hp}thumb_tp" reason="Adjacent"/>
  <disable_collisions link1="${hp}thumb_dp" link2="${hp}thumb_pp" reason="Adjacent"/>
  <disable_collisions link1="${hp}tower" link2="${tfp}link_5_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${tfp}link_1_aluminum" link2="${tfp}link_2_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${tfp}link_2_aluminum" link2="${tfp}link_3_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${tfp}link_3_aluminum" link2="${tfp}link_4_aluminum" reason="Adjacent"/>
  <disable_collisions link1="${tfp}link_4_aluminum" link2="${tfp}link_5_aluminum" reason="Adjacent"/>
  <!-- Default -->
  <disable_collisions link1="${hp}carpals" link2="${hp}thumb_ap" reason="Default"/>
  <!-- Never -->
  <disable_collisions link1="${hp}carpals" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}carpals" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}carpals" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}index_ap" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}index_fingertip_assembly" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}index_pp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}middle_ap" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}middle_fingertip_assembly" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}middle_pp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}pinky_ap" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}pinky_fingertip_assembly" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}pinky_pp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}ring_ap" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}ring_fingertip_assembly" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}ring_pp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}thumb_ap" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}thumb_dp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}thumb_pp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${hp}thumb_tp" reason="Never"/>
  <disable_collisions link1="${tfp}hand_connector" link2="${tfp}link_1_aluminum" reason="Never"/>
