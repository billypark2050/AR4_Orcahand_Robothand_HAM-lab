  <disable_collisions link1="${hp}index_ap" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}index_fingertip_assembly" link2="${tfp}link_2_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}index_fingertip_assembly" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}index_fingertip_assembly" link2="${tfp}link_4_aluminum" reason="Never"/>
