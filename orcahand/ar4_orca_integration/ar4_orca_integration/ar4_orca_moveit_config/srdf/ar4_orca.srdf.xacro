  <disable_collisions link1="${hp}index_pp" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}index_pp" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}index_pp" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_ap" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_ap" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_ap" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_fingertip_assembly" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_fingertip_assembly" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_fingertip_assembly" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_pp" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_pp" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}middle_pp" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_ap" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_ap" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_ap" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_fingertip_assembly" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_fingertip_assembly" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_fingertip_assembly" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_pp" link2="${tfp}link_3_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_pp" link2="${tfp}link_4_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}pinky_pp" link2="${tfp}link_5_aluminum" reason="Never"/>
  <disable_collisions link1="${hp}ring_ap" link2="${tfp}link_3_aluminum" reason="Never"/>
