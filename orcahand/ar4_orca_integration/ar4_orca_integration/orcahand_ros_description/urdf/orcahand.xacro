<?xml version="1.0"?>
<!--
  ORCA Hand v2 macro. Joint names are "${prefix}<orca_core joint id>", angles are
  orca_core degrees converted to radians 1:1 (no per-joint sign table).
  The hand's root link is "${prefix}forearm" (the base that bolts onto the arm).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find orcahand_ros_description)/urdf/orcahand_right_macro.xacro"/>
  <xacro:include filename="$(find orcahand_ros_description)/urdf/orcahand_left_macro.xacro"/>

  <xacro:macro name="orcahand" params="side:=right prefix:=hand_ parent *origin">
    <xacro:if value="${side == 'right'}">
      <xacro:orcahand_right prefix="${prefix}" parent="${parent}">
        <xacro:insert_block name="origin"/>
      </xacro:orcahand_right>
    </xacro:if>
    <xacro:if value="${side == 'left'}">
      <xacro:orcahand_left prefix="${prefix}" parent="${parent}">
        <xacro:insert_block name="origin"/>
      </xacro:orcahand_left>
    </xacro:if>
  </xacro:macro>
</robot>
