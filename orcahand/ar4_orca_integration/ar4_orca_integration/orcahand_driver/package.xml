<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orcahand_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the ORCA Hand built on orca_core: /joint_states, streaming commands, FollowJointTrajectory, torque/e-stop services.</description>
  <maintainer email="billypark2050@gmail.com">Billy Park</maintainer>
  <license>MIT</license>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- orca_core and dynamixel-sdk are pip packages (no rosdep key): see README section 1-3 -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
